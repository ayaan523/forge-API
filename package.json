{
  "name": "forge-api",
  "version": "1.0.0",
  "description": "Task management REST API",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "NODE_ENV=test DATABASE_URL=postgres://test:test@localhost:5432/forge_test JWT_SECRET=test-secret-for-local-tests-only-1234567890 node --test tests/*.test.js",
    "lint": "node --check src/server.js && node --check src/app.js",
    "migrate": "node src/db/migrate.js",
    "migrate:down": "node src/db/migrate.js down"
  },
  "keywords": ["api", "tasks", "express", "postgresql"],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  }
}
